APP_NAME=Signal Feed India
APP_VERSION=4.0.0
APP_ENV=development
DATABASE_URL=postgresql://signalfeed:signalfeed@postgres:5432/signalfeed
REDIS_URL=redis://redis:6379/0
SIGNAL_FEED_SECRET=change-me-in-production
ACCESS_TOKEN_HOURS=12
POLL_INTERVAL_SECONDS=45
TREND_WINDOW_MINUTES=24
MAX_HEADLINES=120
CACHE_TTL_SECONDS=30
ENABLE_REDIS=true
ENABLE_SCHEDULER=true
ENABLE_ALERTING=true
ENABLE_ML_CLASSIFICATION=false
ENABLE_STORY_CLUSTERING=true
